{
  "name": "holafly-qa-framework",
  "version": "1.0.0",
  "description": "Playwright QA Framework for HolaFly Admin Dashboard",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report reports/html",
    "test:discounts": "playwright test tests/discounts",
    "test:dashboard": "playwright test tests/dashboard",
    "test:create-discount": "playwright test tests/discounts/create-discount.spec.ts",
    "auth": "playwright codegen --user-agent=\"hly--dev--go\" --save-storage=fixtures/auth.json https://tools.pre.plat.mnvop.net/platform-admin/modules/discounts",
    "lint": "eslint . --ext .ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}